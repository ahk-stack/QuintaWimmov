# ---------------------------------------------------------------------------
# Quinta Lead Hub — environment
# Copy to .env.local for development. Never commit a filled-in copy.
# ---------------------------------------------------------------------------

# Supabase -------------------------------------------------------------------
# From Supabase dashboard > Project Settings > API Keys. EU region.
# Project URL, e.g. https://<ref>.supabase.co (origin only, no path).
# NEXT_PUBLIC_SUPABASE_URL is still read if this is unset.
SUPABASE_URL=
# SERVER ONLY. The secret key (sb_secret_...). Bypasses RLS entirely.
# Never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=
# The publishable key (sb_publishable_...). The app no longer uses it — the
# browser talks only to this app — but `npm run verify:rls` needs it to prove
# the key can read nothing.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# HubSpot --------------------------------------------------------------------
# Private app token. Scopes: crm.objects.contacts.{read,write},
# crm.objects.companies.{read,write}, crm.objects.deals.{read,write}
# SERVER ONLY.
HUBSPOT_TOKEN=
# Target pipeline and the stage new leads land in (internal IDs, not labels).
HUBSPOT_PIPELINE_ID=
HUBSPOT_DEAL_STAGE_ID=

# Sign-in ------------------------------------------------------------------
# The exact public origin, e.g. https://hub.quinta.im — no trailing slash.
# State-changing requests must carry this Origin. Recommended behind a reverse
# proxy; when blank, the request's Host header is compared instead.
APP_ORIGIN=
# Session cookies are Secure (HTTPS only) in production. Set to true ONLY for an
# internal deployment served over plain HTTP, or sign-in will loop. Never on the
# internet.
AUTH_INSECURE_COOKIES=

# Local development ----------------------------------------------------------
# When the Supabase vars above are blank, the app falls back to a file-backed
# store in .data/ so the UI can be run without credentials.
#
# That fallback refuses to run when NODE_ENV=production, because it keeps state
# on local disk: on a serverless platform each instance gets its own copy and a
# redeploy wipes it. An unconfigured deployment shows a setup screen rather than
# erroring on every route.
#
# Set this to true ONLY for a throwaway demo deployment with no database.
# Never for real leads.
ALLOW_DEV_STORE=
