# ---------------------------------------------------------------------------
# Quinta Lead Hub — environment
# Copy to .env.local for development. Never commit a filled-in copy.
# ---------------------------------------------------------------------------

# Supabase -------------------------------------------------------------------
# From Supabase dashboard > Project Settings > API. Pick an EU region.
# Safe to expose to the browser (read-only, constrained by RLS):
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SERVER ONLY. Bypasses RLS entirely. Never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# HubSpot --------------------------------------------------------------------
# Private app token. Scopes: crm.objects.contacts.{read,write},
# crm.objects.companies.{read,write}, crm.objects.deals.{read,write}
# SERVER ONLY.
HUBSPOT_TOKEN=
# Target pipeline and the stage new leads land in (internal IDs, not labels).
HUBSPOT_PIPELINE_ID=
HUBSPOT_DEAL_STAGE_ID=

# Access -------------------------------------------------------------------
# Optional shared passcode. LEAVE BLANK for a fully open URL, which is the
# configured default. Set it to any word to require one prompt, remembered for
# 30 days. Still no accounts, no passwords per person.
ACCESS_CODE=

# Local development ----------------------------------------------------------
# When the Supabase vars above are blank, the app falls back to a file-backed
# store in .data/ so the UI can be run without credentials.
#
# That fallback refuses to run when NODE_ENV=production, because it keeps state
# on local disk: on a serverless platform each instance gets its own copy and a
# redeploy wipes it. An unconfigured deployment shows a setup screen rather than
# erroring on every route.
#
# Set this to true ONLY for a throwaway demo deployment with no database.
# Never for real leads.
ALLOW_DEV_STORE=
