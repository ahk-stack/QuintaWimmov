# Keep the build context small and free of secrets.

# VCS / tooling
.git
.github
.claude
.vscode

# Dependencies and build output — rebuilt inside the image
node_modules
.next
out
coverage
*.tsbuildinfo
npm-debug.log*

# Secrets: local env files and the Infisical machine-identity config.
# .env.local would otherwise be read by `next build` and baked into the image.
.env*
!.env.example
infisical.config.json

# Local file-backed dev store
.data

# Deployment files — not needed to build the app
docker
k8s
